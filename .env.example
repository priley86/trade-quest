# Local setup generates .env.local with these Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A publishable key can be used instead of the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Dolt, server-only. Leave blank when using DoltHub later.
DOLT_DATABASE_URL=mysql://root@127.0.0.1:3307/tradequest

# Hosted ledger (used only when DOLT_DATABASE_URL is empty).
DOLTHUB_DATABASE=priley86/trade-quest
DOLTHUB_BRANCH=main
DOLTHUB_API_TOKEN=

POKEMON_TCG_API_KEY=
CARDSIGHT_API_KEY=
